APP_NAME=enterprise-rag
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=INFO
LOG_DIR=logs

DATA_DIR=data
UPLOAD_DIR=data/uploads
TEMP_DIR=data/tmp

MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.html
ENABLE_OCR=false
OCR_LANGUAGE=chi_sim+eng

CHUNK_STRATEGY=semantic
CHUNK_SIZE=800
CHUNK_OVERLAP=150
CHUNK_MIN_SIZE=200
PRESERVE_SENTENCE_BOUNDARY=true

CHROMA_PERSIST_DIR=data/chroma
COLLECTION_NAME=enterprise_docs

EMBEDDING_PROVIDER=local
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=E:/your-project/models/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=60
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_DIR=data/cache/embeddings

RETRIEVAL_TOP_K=10
HYBRID_SEARCH_ENABLED=true
VECTOR_TOP_K=20
BM25_TOP_K=20
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
FUSION_MODE=rrf
RRF_K=60

RERANK_ENABLED=true
RERANK_INITIAL_K=50
RERANK_FINAL_K=10
RERANK_MODEL=E:/your-project/models/ms-marco-MiniLM-L-12-v2

LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=your-deepseek-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_STREAM=true
PROMPT_SYSTEM_MESSAGE=你是企业级知识库问答助手，请严格基于检索到的上下文回答问题；如果上下文不足，明确说明不知道，不要编造。
CONTEXT_MAX_CHUNKS=6
CONTEXT_MAX_TOKENS=6000
